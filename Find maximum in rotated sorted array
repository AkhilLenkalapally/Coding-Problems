class Main {
    public static void main(String[] args) {
        int[] nums = {4, 5, 6, 7, 0, 1, 2}; // Example rotated sorted array
        Main obj = new Main();
        System.out.println("Maximum element: " + obj.findMax(nums));
    }

    public int findMax(int[] nums) {
        int low = 0, high = nums.length - 1;

        while (low < high) {
            int mid = low + (high - low) / 2;

            // If mid element is greater than its next element, it's the max
            if (mid < high && nums[mid] > nums[mid + 1]) {
                return nums[mid];
            }

            // If mid element is smaller than its previous element, the previous is the max
            if (mid > 0 && nums[mid] < nums[mid - 1]) {
                return nums[mid - 1];
            }

            // If mid element is greater than high, max must be on the right half
            if (nums[mid] > nums[high]) {
                low = mid + 1;
            } else {
                high = mid;
            }
        }

        return nums[low]; // The max element
    }
}
