class Solution {
    public int[] twoSum(int[] nums, int target) {
        Map <Integer, Integer> nMap = new HashMap<>();
        int n = nums.length;
        for(int i =0; i<n; i++){
            int req = target - nums[i];
            if(nMap.containsKey(req))
            {
                return new int[]{nMap.get(req),i};
            }
            nMap.put(nums[i],i);
        }
        return new int[]{};
    }
}


